{
  "name": "duelhippo",
  "productName": "Duel Hippo",
  "version": "0.9.0",
  "description": "Duel Hippo — a 3D biplane dogfighter in the spirit of the 1984 side-scrollers. Part of the Hippo family.",
  "author": "Jason Figge",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "app/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "test": "node --test --test-timeout=120000 \"app/tests/*.test.js\" \"web/scripts/tests/*.test.js\"",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "fmt-check": "prettier --check ."
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "three": "^0.187.0",
    "three-r128": "npm:three@^0.128.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.duelhippo.app",
    "productName": "Duel Hippo",
    "copyright": "Copyright © 2026 Jason Figge",
    "artifactName": "Duel-Hippo-${version}-${arch}.${ext}",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "app/**/*",
      "!app/tests/**",
      "www/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.action-games",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "icons/mac.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icons/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Game",
      "icon": "icons/linux"
    },
    "nsis": {
      "artifactName": "Duel-Hippo-Setup-${version}-${arch}.${ext}"
    }
  }
}
